# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Python
__pycache__/
backend/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# AI / agent tooling — local dev scaffolding, not part of the product
.agent/
.cursor/
GEMINI.md

# Logs
*.log

# Databases & vector store
*.db
*.db-wal
*.db-shm
flux_chroma/
flux_market.db*

# Local model artifacts (large / re-trainable — see docs/)
*.gguf
*.pkl
*.pt

# …except the trained artifacts the prediction API loads at request time. They
# are ~3.5 MB total and the deployed image is useless without them, so the
# active model set is tracked despite the patterns above.
!backend/prediction/models/*.pkl
!backend/prediction/models/*.pt
!backend/prediction/models/*.json

# Archived and experimental training runs stay out — nothing serves from these.
backend/prediction/models/baseline_backup/
backend/prediction/models/fred_model_gate1/

# Training datasets (multi-GB, re-downloadable — see docs/DATASETS.md)
Dataset/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
test-results/
playwright-report/

# Stray pip-redirect files
=*.*

# Wrangler build artifacts and local miniflare state.
keep-warm-worker/.wrangler/

# Local scratch notes
Run_commands.txt
